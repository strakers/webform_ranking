# Ignore the DDEV wrapper environment
.ddev/

# Ignore the virtualized runtime files generated by composer/poser
/vendor/
/web/
/recipes/
/sites/
/archived/

# Ignore local editor footprints
.idea/
.vscode/

.DS_Store

# Ignore generated pa11y-ci-report output, keep the directory itself.
/reports/pa11y/*/
!/reports/pa11y/.gitkeep
